# Database
DATABASE_URL=postgresql://selaren:selaren@localhost:5432/selaren?schema=public

# Session signing (min 32 characters)
SELAREN_SESSION_SECRET=replace-with-at-least-32-characters-secret

# AES-256-GCM key as 64 hex chars (32 bytes)
SELAREN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Seeded operator (prisma/seed.ts). Required. Production rejects this example value.
# Re-running seed does not overwrite an existing operator password unless
# SELAREN_OPERATOR_RESET_PASSWORD=true
SELAREN_OPERATOR_EMAIL=founder@selaren.local
SELAREN_OPERATOR_PASSWORD=change-this-password

# Meta WhatsApp Cloud API (app-level)
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=selaren-dev-verify-token
WHATSAPP_GRAPH_VERSION=v21.0

# LLM (Selaren-level, not per clinic)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: protect /api/internal/tick
CRON_SECRET=replace-cron-secret

# App
NEXT_PUBLIC_APP_NAME=Selaren
NODE_ENV=development
